{
  "$schema": "zed://schemas/settings",
  "cli_default_open_behavior": "new_window",
  "use_system_window_tabs": true,
  "ui_font_family": "Geist",
  "ui_font_size": 16.0,
  "buffer_font_family": "GeistMono Nerd Font",
  "buffer_font_size": 15,
  "title_bar": {
    "show_branch_name": true,
    "show_branch_status_icon": false,
    "show_menus": true,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": true
  },
  "status_bar": {
    "cursor_position_button": false,
    "active_language_button": false
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "gutter": {
    "line_numbers": true,
    "code_actions": true,
    "folds": true
  },
  "minimap": {
    "show": "never"
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "terminal": {
    "button": false,
    "font_family": "GeistMono Nerd Font",
    "font_size": 15.0,
    "dock": "bottom"
  },
  "project_panel": {
    "dock": "left",
    "button": false
  },
  "outline_panel": {
    "dock": "left",
    "button": false
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "agent": {
    "dock": "right",
    "button": false,
    "enabled": true,
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left",
    "button": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "icon_theme": "Zed (Default)",
  "base_keymap": "JetBrains",
  "theme": "One Light",
  "theme_overrides": {
    "One Light": {
      "terminal.background": "#FDF6E3ff",
      "terminal.foreground": "#000000ff",
      "terminal.ansi.black": "#073642ff",
      "terminal.ansi.red": "#dc322fff",
      "terminal.ansi.green": "#7aca8cff",
      "terminal.ansi.yellow": "#bf9c49ff",
      "terminal.ansi.blue": "#7a9dc8ff",
      "terminal.ansi.magenta": "#d33682ff",
      "terminal.ansi.cyan": "#2aa198ff",
      "terminal.ansi.white": "#eee8d5ff",
      "terminal.ansi.bright_black": "#002b36ff",
      "terminal.ansi.bright_red": "#cb4b16ff",
      "terminal.ansi.bright_green": "#586e75ff",
      "terminal.ansi.bright_yellow": "#657b83ff",
      "terminal.ansi.bright_blue": "#839496ff",
      "terminal.ansi.bright_magenta": "#6c71c4ff",
      "terminal.ansi.bright_cyan": "#93a1a1ff",
      "terminal.ansi.bright_white": "#fdf6e3ff",
      "terminal.cursor": "#657b83ff"
    }
  }
}
