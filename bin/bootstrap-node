#!/bin/bash
# Install the default Node.js version using Herd's NVM.

set -e

NODE_VERSION="${NODE_VERSION:-22}"
NVM_DIR="$HOME/Library/Application Support/Herd/config/nvm"
NVM_SOURCE="$NVM_DIR/nvm.sh"

if [ ! -s "$NVM_SOURCE" ]; then
    NVM_SOURCE="/Applications/Herd.app/Contents/Resources/nvm/nvm.sh"
fi

if [ ! -s "$NVM_SOURCE" ]; then
    echo "Herd's NVM is unavailable. Install Herd before running bin/bootstrap-node." >&2
    exit 1
fi

export NVM_DIR
mkdir -p "$NVM_DIR"
# shellcheck source=/dev/null
. "$NVM_SOURCE"

nvm install "$NODE_VERSION"
nvm use "$NODE_VERSION"
nvm alias default "$NODE_VERSION"

echo "Node $(node --version) is installed and set as the default"
