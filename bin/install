#!/bin/bash
#
# Install dotfiles: Homebrew packages, Oh My Zsh + plugins, and symlinks.
# Safe to re-run. Existing files are moved to ~/.dotfiles-backup/<timestamp>/.

set -e

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"
BACKUP="$HOME/.dotfiles-backup/$(date +%Y%m%d-%H%M%S)"

step() { echo ""; echo -e "\033[0;34m➜\033[0m $1"; }
success() { echo -e "\033[0;32m✓\033[0m $1"; }

link() {
    local src="$DOTFILES/$1" dest="$2"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        mkdir -p "$BACKUP"
        mv "$dest" "$BACKUP/"
        echo "  backed up $dest"
    fi
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$src" "$dest"
    echo "  $dest -> $src"
}

step "Homebrew"
if ! command -v brew &> /dev/null; then
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
brew bundle --file="$DOTFILES/config/Brewfile"
success "Homebrew packages installed"

step "Oh My Zsh"
if [ ! -d "$HOME/.oh-my-zsh" ]; then
    RUNZSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
fi
ZSH_CUSTOM="$HOME/.oh-my-zsh/custom"
[ -d "$ZSH_CUSTOM/themes/powerlevel10k" ] || git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k"
[ -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ] || git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
success "Oh My Zsh ready"

step "Symlinks"
link home/.zshrc            "$HOME/.zshrc"
link home/.p10k.zsh         "$HOME/.p10k.zsh"
link home/.gitconfig        "$HOME/.gitconfig"
link home/.global-gitignore "$HOME/.global-gitignore"
link home/.tmux.conf        "$HOME/.tmux.conf"
link config/zed/settings.json "$HOME/.config/zed/settings.json"
link config/zed/keymap.json   "$HOME/.config/zed/keymap.json"
link config/ghostty/config    "$HOME/.config/ghostty/config"
success "Symlinks created"

step "PhpStorm settings"
PHPSTORM_PRODUCT_INFO="/Applications/PhpStorm.app/Contents/Resources/product-info.json"
if [ -f "$PHPSTORM_PRODUCT_INFO" ]; then
    PHPSTORM_DIR_NAME="$(plutil -extract dataDirectoryName raw "$PHPSTORM_PRODUCT_INFO")"
    PHPSTORM_CONFIG="$HOME/Library/Application Support/JetBrains/$PHPSTORM_DIR_NAME"
    for setting in \
        options/advancedSettings.xml \
        options/colors.scheme.xml \
        options/editor-font.xml \
        options/editor.xml \
        options/filetypes.xml \
        options/ide.general.xml \
        options/mac/keymap.xml \
        options/php.xml \
        options/terminal.xml \
        options/ui.lnf.xml \
        keymaps/ryan-catapang.xml; do
        link "config/phpstorm/$setting" "$PHPSTORM_CONFIG/$setting"
    done
    success "PhpStorm settings linked for $PHPSTORM_DIR_NAME"
else
    echo "  PhpStorm not found; settings skipped"
fi

step "Git LFS"
git lfs install --skip-repo > /dev/null
success "Git LFS enabled"

step "Herd runtimes"
HERD_BIN="$HOME/Library/Application Support/Herd/bin"
HERD_APP="/Applications/Herd.app"

if [ ! -x "$HERD_BIN/herd" ] && [ -d "$HERD_APP" ]; then
    echo "  Launching Herd for first-time initialization..."
    open -a Herd
    echo "  Complete any prompts in Herd; installation will continue automatically."

    for ((attempt = 1; attempt <= 150; attempt++)); do
        [ -x "$HERD_BIN/herd" ] && break
        if ((attempt % 5 == 0)); then
            echo "  Waiting for Herd to finish initialization..."
        fi
        sleep 2
    done
fi

if [ -x "$HERD_BIN/herd" ]; then
    export PATH="$HERD_BIN:$PATH"
    "$DOTFILES/bin/bootstrap-php"
    success "Herd PHP versions and Composer tools installed"
else
    echo "Herd did not finish initialization within five minutes." >&2
    exit 1
fi

HERD_NVM="$HOME/Library/Application Support/Herd/config/nvm/nvm.sh"
HERD_BUNDLED_NVM="$HERD_APP/Contents/Resources/nvm/nvm.sh"
if [ -s "$HERD_NVM" ] || [ -s "$HERD_BUNDLED_NVM" ]; then
    "$DOTFILES/bin/bootstrap-node"
    success "Node version from .nvmrc installed through Herd"
else
    echo "Herd's NVM is unavailable after initialization." >&2
    exit 1
fi

echo ""
success "Done. Open a new terminal, or run: exec zsh"
