#!/usr/bin/env bash
#
# Merge portable status-line settings without replacing unrelated agent config.

set -euo pipefail

CLAUDE_SETTINGS="$HOME/.claude/settings.json"
CODEX_CONFIG="$HOME/.codex/config.toml"
CLAUDE_STATUS_COMMAND='bash ~/.claude/statusline-command.sh'
CODEX_STATUS_ITEMS='["project-root", "model-with-reasoning", "git-branch", "branch-changes", "context-used", "five-hour-limit", "weekly-limit"]'

mkdir -p "$(dirname "$CLAUDE_SETTINGS")" "$(dirname "$CODEX_CONFIG")"

if [ ! -f "$CLAUDE_SETTINGS" ]; then
	printf '{}\n' >"$CLAUDE_SETTINGS"
fi

claude_tmp=$(mktemp "${TMPDIR:-/tmp}/claude-settings.XXXXXX")
codex_tmp=$(mktemp "${TMPDIR:-/tmp}/codex-config.XXXXXX")
cleanup() {
	rm -f "$claude_tmp" "$codex_tmp"
}
trap cleanup EXIT

jq --arg command "$CLAUDE_STATUS_COMMAND" '
    .statusLine = {
        "type": "command",
        "command": $command,
        "refreshInterval": 60
    }
' "$CLAUDE_SETTINGS" >"$claude_tmp"
cp "$claude_tmp" "$CLAUDE_SETTINGS"

if [ ! -f "$CODEX_CONFIG" ]; then
	: >"$CODEX_CONFIG"
fi

awk \
	-v status_line="status_line = $CODEX_STATUS_ITEMS" \
	-v colors="status_line_use_colors = true" '
    function write_missing_tui_values() {
        if (!wrote_status_line) {
            print status_line
            wrote_status_line = 1
        }
        if (!wrote_colors) {
            print colors
            wrote_colors = 1
        }
    }

    /^\[tui\][[:space:]]*$/ {
        in_tui = 1
        saw_tui = 1
        print
        next
    }

    /^\[[^]]+\][[:space:]]*$/ {
        if (in_tui) {
            write_missing_tui_values()
            in_tui = 0
        }
        print
        next
    }

    in_tui && /^[[:space:]]*status_line[[:space:]]*=/ {
        if (!wrote_status_line) {
            print status_line
            wrote_status_line = 1
        }
        next
    }

    in_tui && /^[[:space:]]*status_line_use_colors[[:space:]]*=/ {
        if (!wrote_colors) {
            print colors
            wrote_colors = 1
        }
        next
    }

    { print }

    END {
        if (in_tui) {
            write_missing_tui_values()
        } else if (!saw_tui) {
            if (NR > 0) {
                print ""
            }
            print "[tui]"
            write_missing_tui_values()
        }
    }
' "$CODEX_CONFIG" >"$codex_tmp"
cp "$codex_tmp" "$CODEX_CONFIG"
